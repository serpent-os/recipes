From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Mon, 12 Oct 2026 12:00:00 -0500
Subject: [PATCH] Fix the build with Clang 23

Clang 23 defaults to C23 and is stricter than GCC in a couple of places
that mdadm builds with -Werror:

- A function definition with an empty parameter list is a deprecated
  non-prototype in C23, and -Wstrict-prototypes promotes it to an error.
  The matching declarations in the headers already use (void); make the
  definitions match.
- -Wunused-function fires for the static inline functions generated by
  the ASSERT_SIZE macro, which only exist for their compile-time size
  check. Mark them unused.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-10-12
---
 config.c      | 2 +-
 crc32.c       | 2 +-
 dlink.c       | 2 +-
 super-intel.c | 2 +-
 util.c        | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/config.c b/config.c
index 373acd4..fd65750 100644
--- a/config.c
+++ b/config.c
@@ -1092,7 +1092,7 @@ static void append_dlist(struct mddev_dev **dlp, struct mddev_dev *list)
 	*dlp = list;
 }
 
-struct mddev_dev *conf_get_devs()
+struct mddev_dev *conf_get_devs(void)
 {
 	glob_t globbuf;
 	struct conf_dev *cd;
diff --git a/crc32.c b/crc32.c
index 94fda06..1da6909 100644
--- a/crc32.c
+++ b/crc32.c
@@ -126,7 +126,7 @@ local void make_crc_table OF((void));
   allow for word-at-a-time CRC calculation for both big-endian and little-
   endian machines, where a word is four bytes.
 */
-local void make_crc_table()
+local void make_crc_table(void)
 {
     unsigned long c;
     int n, k;
diff --git a/dlink.c b/dlink.c
index 3463367..007e545 100644
--- a/dlink.c
+++ b/dlink.c
@@ -11,7 +11,7 @@ char *strncpy(char *dest, const char *src, size_t n) __THROW;
 void *xcalloc(size_t num, size_t size);
 #include	"dlink.h"
 
-void *dl_head()
+void *dl_head(void)
 {
     void *h;
     h = dl_alloc(0);
diff --git a/super-intel.c b/super-intel.c
index 7cae5cd..b9f6579 100644
--- a/super-intel.c
+++ b/super-intel.c
@@ -133,7 +133,7 @@
  * changes the size of a struct
  */
 #define ASSERT_SIZE(_struct, size) \
-static inline void __assert_size_##_struct(void)	\
+static inline void __attribute__((unused)) __assert_size_##_struct(void)	\
 {							\
 	switch (0) {					\
 	case 0: break;					\
diff --git a/util.c b/util.c
index cdc5543..e00de78 100644
--- a/util.c
+++ b/util.c
@@ -307,7 +307,7 @@ int md_get_disk_info(int fd, struct mdu_disk_info_s *disk)
 	return ioctl(fd, GET_DISK_INFO, disk);
 }
 
-int get_linux_version()
+int get_linux_version(void)
 {
 	struct utsname name;
 	char *cp;
