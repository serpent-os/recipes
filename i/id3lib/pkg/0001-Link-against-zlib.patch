From 646fa7bf2a65b027b167286f71c1e2bd695393e0 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Mon, 12 Oct 2026 12:00:00 -0500
Subject: [PATCH 01/11] Link against zlib

Origin: Gentoo
Forwarded: not-needed
Last-Update: 2026-10-13
---
 Makefile.am     | 2 +-
 src/Makefile.am | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/Makefile.am b/Makefile.am
index 3181288..fb36bde 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -28,7 +28,7 @@ zlib_subdir =
 endif
 
 SUBDIRS =  . m4 $(zlib_subdir) doc include id3com src examples
-DIST_SUBDIRS = . m4 zlib doc include id3com src examples prj libprj
+DIST_SUBDIRS = . m4 $(zlib_subdir) doc include id3com src examples prj libprj
 
 INCLUDES = @ID3LIB_DEBUG_FLAGS@
 
diff --git a/src/Makefile.am b/src/Makefile.am
index 8b0f682..4172f3d 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -77,6 +77,7 @@ LDADD        = $(top_builddir)/zlib/src/libz.la
 endif
 
 libid3_la_LDFLAGS = \
+  -lz \
   -version-info $(LT_VERSION) \
   -release $(LT_RELEASE) \
   -export-dynamic
