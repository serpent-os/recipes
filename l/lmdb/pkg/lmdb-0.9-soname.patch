From 27000e61d76717d723d535684960976abd9c88f3 Mon Sep 17 00:00:00 2001
From: Reilly Brogan <reilly@reillybrogan.com>
Date: Mon, 12 Oct 2026 00:00:00 -0500
Subject: [PATCH] Build a versioned shared library with a stable soname

LMDB 0.9 builds an unversioned liblmdb.so without an soname. Give it the
versioned file name and soname that aerynOS has always shipped
(liblmdb.so.0.0.0) so that binaries compiled against the 0.9 series keep
resolving while they are rebuilt against LMDB 1.0.

The mdb_* utilities are intentionally left linked against the static
liblmdb.a rather than the shared library so that the compatibility
package is self-contained.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-10-12
---
 libraries/liblmdb/Makefile | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/libraries/liblmdb/Makefile b/libraries/liblmdb/Makefile
index 000f1f9..c22625c 100644
--- a/libraries/liblmdb/Makefile
+++ b/libraries/liblmdb/Makefile
@@ -26,6 +26,7 @@ OPT = -O2 -g
 CFLAGS	= $(THREADS) $(OPT) $(W) $(XCFLAGS)
 LDLIBS	=
 SOLIBS	=
+SOVERSION	= 0.0.0
 SOEXT	= .so
 prefix	= /usr/local
 exec_prefix = $(prefix)
@@ -38,7 +39,7 @@ mandir = $(datarootdir)/man
 ########################################################################
 
 IHDRS	= lmdb.h
-ILIBS	= liblmdb.a liblmdb$(SOEXT)
+ILIBS	= liblmdb$(SOEXT) liblmdb$(SOEXT).$(SOVERSION)
 IPROGS	= mdb_stat mdb_copy mdb_dump mdb_load
 IDOCS	= mdb_stat.1 mdb_copy.1 mdb_dump.1 mdb_load.1
 PROGS	= $(IPROGS) mtest mtest2 mtest3 mtest4 mtest5
@@ -64,9 +65,13 @@ test:	all
 liblmdb.a:	mdb.o midl.o
 	$(AR) rs $@ mdb.o midl.o
 
-liblmdb$(SOEXT):	mdb.lo midl.lo
+liblmdb$(SOEXT):	liblmdb$(SOEXT).$(SOVERSION)
+	rm -f $@
+	ln -s $< $@
+
+liblmdb$(SOEXT).$(SOVERSION):	mdb.lo midl.lo
 #	$(CC) $(LDFLAGS) -pthread -shared -Wl,-Bsymbolic -o $@ mdb.o midl.o $(SOLIBS)
-	$(CC) $(LDFLAGS) -pthread -shared -o $@ mdb.lo midl.lo $(SOLIBS)
+	$(CC) $(LDFLAGS) -pthread -shared -Wl,-soname,$@ -o $@ mdb.lo midl.lo $(SOLIBS)
 
 mdb_stat: mdb_stat.o liblmdb.a
 mdb_copy: mdb_copy.o liblmdb.a
