+	/* CEF ships a Chrome Root Store and an empty CRLSet frozen at build time.
+	 * Load the distro-provided CRLSet so revoked CAs are rejected. */
+	BPtr<char> crlset_alloc = obs_module_file("crlset");
+	const char *crlset_path = crlset_alloc;
+	if (crlset_path && os_file_exists(crlset_path)) {
+		blog(LOG_INFO, "[obs-browser]: Loading CRLSet from %s", crlset_path);
+		CefLoadCRLSetsFile(crlset_path);
+	} else {
+		blog(LOG_WARNING, "[obs-browser]: CRLSet not found");
+	}
+
 	// Register custom scheme handler for local browser sources
 	CefRegisterSchemeHandlerFactory("http", "absolute", new BrowserSchemeHandlerFactory());
 
