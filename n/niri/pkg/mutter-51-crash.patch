From d054395225560bbd39a76f958a5f612de4f284b0 Mon Sep 17 00:00:00 2001
From: Ivan Molodetskikh <yalterz@gmail.com>
Date: Thu, 15 Oct 2026 07:51:41 +0300
Subject: [PATCH] Add new types to Mutter.ServiceChannel

Works around nautilus libgxdp crash.
---
 src/dbus/mutter_service_channel.rs | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/dbus/mutter_service_channel.rs b/src/dbus/mutter_service_channel.rs
index 89d31345fa..4de971f5b0 100644
--- a/src/dbus/mutter_service_channel.rs
+++ b/src/dbus/mutter_service_channel.rs
@@ -15,7 +15,14 @@ impl ServiceChannel {
         &mut self,
         service_client_type: u32,
     ) -> fdo::Result<zvariant::OwnedFd> {
-        if service_client_type != 1 {
+        // ServiceClientTypes:
+        //    PORTAL_BACKEND: 1
+        //    FILECHOOSER_PORTAL_BACKEND: 2
+        //    GLOBAL_SHORTCUTS_PORTAL_BACKEND: 3
+        //
+        // In mutter, 1 and 2 get access to mutter_x11_interop.
+        // Ours is a stub, so we don't do this filtering.
+        if !matches!(service_client_type, 1..=3) {
             return Err(fdo::Error::InvalidArgs(
                 "Invalid service client type".to_owned(),
             ));
