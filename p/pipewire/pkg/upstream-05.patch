From 8873c752ec05b701a2f8153f8f9eb4f06c378ebc Mon Sep 17 00:00:00 2001
From: Mikhail Gavrilov <mikhail.v.gavrilov@gmail.com>
Date: Wed, 30 Sep 2026 21:48:13 +0000
Subject: [PATCH] spa: acp: don't fall back to opening UCM by card name

With two cards of the same short name, where UCM applies to one and not
the other, the second card gets the first card's UCM configuration: its
nodes open the first card's PCMs, its volumes move the first card's
mixer, and it never gets the generic ACP profile it should have.

pa_alsa_ucm_query_profiles() opens UCM by "hw:N" and, when that fails,
retries with the name from snd_card_get_name(). The retry cannot find a
configuration for this card that the first attempt missed. Since
alsa-lib 1.2.1 an "hw:N" open resolves the card itself, and an open by a
name that matches a card goes through the same ucm.conf lookup for
whichever card the name resolves to -- alsa-lib takes the first card
with that name. For a unique name that is this card and the same result;
for a shared name it can be another card.

SPA requires alsa-lib 1.2.6, so the "hw:N" open is always available.
Drop the fallback: when it fails, UCM is not available for this card.

Fixes #5500

Signed-off-by: Mikhail Gavrilov <mikhail.v.gavrilov@gmail.com>
Origin: upstream, https://gitlab.freedesktop.org/pipewire/pipewire/-/commit/8873c752ec05b701a2f8153f8f9eb4f06c378ebc
Forwarded: not-needed
Last-Update: 2026-10-13
---
 spa/plugins/alsa/acp/alsa-ucm.c | 27 +++------------------------
 1 file changed, 3 insertions(+), 24 deletions(-)

diff --git a/spa/plugins/alsa/acp/alsa-ucm.c b/spa/plugins/alsa/acp/alsa-ucm.c
index 30c1fe24d..63d24690e 100644
--- a/spa/plugins/alsa/acp/alsa-ucm.c
+++ b/spa/plugins/alsa/acp/alsa-ucm.c
@@ -980,29 +980,9 @@ int pa_alsa_ucm_query_profiles(pa_alsa_ucm_config *ucm, int card_index) {
         return -PA_ALSA_ERR_UNSPECIFIED;
     err = snd_use_case_mgr_open(&ucm->ucm_mgr, card_name);
     if (err < 0) {
-        char *ucm_card_name;
-
-        /* fallback longname: is UCM available for this card ? */
-        pa_xfree(card_name);
-        err = snd_card_get_name(card_index, &ucm_card_name);
-        if (err < 0) {
-            pa_log("Card can't get card_name from card_index %d", card_index);
-            err = -PA_ALSA_ERR_UNSPECIFIED;
-            goto name_fail;
-        }
-        card_name = pa_sprintf_malloc("%s%s", split_prefix, ucm_card_name);
-        free(ucm_card_name);
-        if (card_name == NULL) {
-            err = -PA_ALSA_ERR_UNSPECIFIED;
-            goto name_fail;
-        }
-
-        err = snd_use_case_mgr_open(&ucm->ucm_mgr, card_name);
-        if (err < 0) {
-            pa_log_info("UCM not available for card %s", card_name);
-            err = -PA_ALSA_ERR_UCM_OPEN;
-            goto ucm_mgr_fail;
-        }
+        pa_log_info("UCM not available for card %s", card_name);
+        err = -PA_ALSA_ERR_UCM_OPEN;
+        goto ucm_mgr_fail;
     }
 
     err = snd_use_case_get(ucm->ucm_mgr, "=Linked", &value);
@@ -1064,7 +1044,6 @@ ucm_verb_fail:
 ucm_mgr_fail:
     pa_xfree(card_name);
 
-name_fail:
     return err;
 }
 
